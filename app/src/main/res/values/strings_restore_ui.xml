    <string name="restore_ui_risky_downgrade_hint">Install a backed-up version that is older than the installed one (Shizuku or root).</string>
    <string name="restore_ui_risky_downgrade_consequence">An older app version may not understand data written by the newer one. The app can crash or lose its data. Android may refuse the downgrade for some apps.</string>
    <string name="restore_ui_risky_cross_slot">Allow writing to the other slot</string>
    <string name="restore_ui_risky_cross_slot_hint">The chosen slot differs from the slot that was imaged.</string>
    <string name="restore_ui_risky_cross_slot_consequence">The other slot\'s partitions are replaced. If the images do not match the rest of that slot, the device may fail to boot from it; on the next update it may also switch to that slot.</string>
    <string name="restore_ui_risky_other_device">Allow images from another device</string>
    <string name="restore_ui_risky_other_device_hint">The images were taken on a different device model, or their origin cannot be proven.</string>
    <string name="restore_ui_risky_other_device_consequence">Partition images are specific to one device model. Writing another device\'s image can hard-brick this device so that only a factory flashing tool can recover it.</string>
    <string name="restore_ui_risky_other_build">Allow images from another build</string>
    <string name="restore_ui_risky_other_build_hint">Same device, but a different system build (for example before an update).</string>
    <string name="restore_ui_risky_other_build_consequence">Mixing partitions from different builds can cause boot loops or broken features (camera, radio, encryption). Restore every partition of that build together.</string>
    <string name="restore_ui_risky_smaller_image">Allow images smaller than the partition</string>
    <string name="restore_ui_risky_smaller_image_hint">The end of the partition is left as it is.</string>
    <string name="restore_ui_risky_smaller_image_consequence">The partition keeps old data after the image. That is harmless for some partitions and breaks others (for example ones with a footer or signature at the end).</string>
    <string name="restore_ui_risky_identity">Allow writing identity partitions</string>
    <string name="restore_ui_risky_identity_hint">IMEI/NV, modem calibration, persist, factory reset protection and similar.</string>
