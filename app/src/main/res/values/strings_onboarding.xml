<!-- First-launch onboarding wizard (ui/onboarding), reusable licenses screen (ui/licenses) and the
     enum -> label mapping (ui/mapping). Pipeline enum labels live here so every later screen that
     shows an ArchiveFormat, ChecksumAlgorithm or DestinationType reuses the same wording. -->
<resources>

    <!-- ===================== Wizard chrome ===================== -->
    <string name="onboarding_title">Welcome to DFTB</string>
    <string name="onboarding_step_counter">Step %1$d of %2$d</string>
    <string name="onboarding_back">Back</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_finish">Finish</string>
    <string name="onboarding_finishing">Saving your choices…</string>
    <string name="onboarding_no_app_for_link">No app on this device can open that link.</string>
    <string name="onboarding_no_app_for_action">No system screen is available for this action on this device.</string>
    <string name="onboarding_finish_requires_mode">Choose an operating mode that is available on this device before finishing.</string>
    <string name="onboarding_finish_error">Your choices could not be saved. Please try again.</string>

    <!-- ===================== Step 1: language ===================== -->
    <string name="onboarding_language_title">Choose your language</string>
    <string name="onboarding_language_description">The whole app switches instantly. You can change this later from the system overview or Settings.</string>
    <string name="onboarding_language_suggested">Suggested from your device settings: %1$s</string>
    <string name="onboarding_language_use_suggested">Use %1$s</string>

    <!-- ===================== Step 2: overview ===================== -->
    <string name="onboarding_overview_title">What DFTB can do</string>
    <string name="onboarding_overview_description">An open-source backup and disaster-recovery toolkit for the device you own. Everything below is optional; you decide what to protect and where it goes.</string>
    <string name="onboarding_feature_partitions_title">Partition images</string>
    <string name="onboarding_feature_partitions_desc">Block-level images of boot, vendor_boot, dtbo, persist and other partitions, including the active or inactive A/B slot (root modes).</string>
    <string name="onboarding_feature_apps_title">Apps</string>
    <string name="onboarding_feature_apps_desc">APK and split APKs, internal data, external data, OBB expansion files and caches, selected per app.</string>
    <string name="onboarding_feature_files_title">Files and categories</string>
    <string name="onboarding_feature_files_desc">Any folder, plus smart categories such as photos, videos, documents and databases, narrowed with size, date and pattern filters.</string>
    <string name="onboarding_feature_destinations_title">Destinations</string>
    <string name="onboarding_feature_destinations_desc">Local storage, USB OTG drives, FTP/FTPS, SFTP/SSH, SMB, WebDAV and NFS servers, and any cloud provider reachable through rclone.</string>
    <string name="onboarding_feature_pipelines_title">Flexible pipelines</string>
    <string name="onboarding_feature_pipelines_desc">tar or zip containers with zstd, xz, gzip or bzip2 compression, AES-256 encryption with filename masking, checksum manifests, and direct streaming to the destination.</string>
    <string name="onboarding_feature_twrp_title">Recovery-compatible backups</string>
    <string name="onboarding_feature_twrp_desc">Optional TWRP and OrangeFox compatible layouts so a backup can also be restored from custom recovery.</string>
    <string name="onboarding_feature_restore_title">Full-symmetry restore</string>
    <string name="onboarding_feature_restore_desc">Everything DFTB backs up it can restore: whole profiles, single apps, selected files or one partition image, with integrity verification first.</string>
    <string name="onboarding_feature_scheduling_title">Scheduling, retention and resume</string>
    <string name="onboarding_feature_scheduling_desc">Daily, weekly or interval schedules with Wi‑Fi, charging and battery conditions; automatic pruning of old backups; interrupted jobs resume from their last checkpoint.</string>

    <!-- ===================== Step 3: responsibility ===================== -->
    <string name="onboarding_disclaimer_title">Your responsibility</string>
    <string name="onboarding_disclaimer_description">DFTB gives you powerful, low-level control over your own device. Please read these points before continuing.</string>
    <string name="onboarding_disclaimer_partitions">Writing partitions can render a device unbootable. Only restore partition images you created on this exact device and firmware.</string>
    <string name="onboarding_disclaimer_verify">Always verify backups and keep a second copy on a different medium. A backup you have never tested is not a backup.</string>
    <string name="onboarding_disclaimer_passwords">Encryption passwords and keys cannot be recovered. If you lose them, the encrypted backup is lost too.</string>
    <string name="onboarding_disclaimer_elevation">Granting root or Shizuku access, and whatever is done with it, is your decision and your responsibility. DFTB only uses it for the operations you start or schedule.</string>
    <string name="onboarding_disclaimer_cloud">Cloud and network storage is subject to the provider\'s terms, availability and pricing. DFTB does not control third-party services.</string>
    <string name="onboarding_disclaimer_warranty">DFTB is free, open-source software provided without any warranty, under the terms of its open-source license.</string>
    <string name="onboarding_disclaimer_accept">I understand and accept</string>

    <!-- ===================== Step 4: licenses ===================== -->
    <string name="onboarding_licenses_title">Open-source licenses and credits</string>
    <string name="onboarding_licenses_description">DFTB stands on the shoulders of these projects. Tap an entry for details; the Source and License buttons open the project in your browser.</string>
