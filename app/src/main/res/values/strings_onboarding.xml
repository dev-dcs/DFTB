    <!-- ===================== Step 5: operating mode ===================== -->
    <string name="onboarding_mode_title">Operating mode</string>
    <string name="onboarding_mode_description">Pick how DFTB may access your device. Each choice is checked live; you can switch modes later in Settings.</string>
    <string name="onboarding_mode_select_hint">Select a mode above to run the diagnostics.</string>
    <string name="onboarding_mode_selected">Selected</string>
    <string name="onboarding_diagnostics_running">Checking %1$s… this can take a few seconds if a superuser prompt is waiting.</string>
    <string name="onboarding_diagnostics_failed">The diagnostics could not be completed.</string>
