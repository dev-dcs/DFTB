    <!-- Warnings -->
    <string name="shell_warn_elevation_title">Η πρόσβαση %1$s δεν είναι διαθέσιμη</string>
    <string name="shell_warn_elevation_root_body">Το root δεν έχει παραχωρηθεί αυτή τη στιγμή στο DFTB. Δεδομένα εφαρμογών, κατατμήσεις και άλλα προνομιούχα στοιχεία δεν μπορούν να αντιγραφούν ή να επαναφερθούν μέχρι να παραχωρηθεί.</string>
    <string name="shell_warn_elevation_shizuku_body">Η υπηρεσία Shizuku δεν εκτελείται ή το DFTB έχασε την άδειά του. Ξεκινήστε το Shizuku (σταματά σε κάθε επανεκκίνηση) για να αντιγράψετε δεδομένα εφαρμογών.</string>
