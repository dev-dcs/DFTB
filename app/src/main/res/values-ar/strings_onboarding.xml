    <!-- ===================== Step 1: language ===================== -->
    <string name="onboarding_language_title">اختر لغتك</string>
    <string name="onboarding_language_description">يتبدّل التطبيق بالكامل فورًا. يمكنك تغيير ذلك لاحقًا من نظرة عامة على النظام أو من الإعدادات.</string>
    <string name="onboarding_language_suggested">مُقترحة من إعدادات جهازك: %1$s</string>
    <string name="onboarding_language_use_suggested">استخدام %1$s</string>

    <!-- ===================== Step 2: overview ===================== -->
    <string name="onboarding_overview_title">ما الذي يستطيع DFTB فعله</string>
    <string name="onboarding_overview_description">مجموعة أدوات مفتوحة المصدر للنسخ الاحتياطي والتعافي من الكوارث للجهاز الذي تملكه. كل ما يلي اختياري؛ أنت من يقرّر ما يُحمى وإلى أين يذهب.</string>
    <string name="onboarding_feature_partitions_title">صور الأقسام</string>
    <string name="onboarding_feature_partitions_desc">صور على مستوى الكتل لأقسام boot وvendor_boot وdtbo وpersist وغيرها، بما في ذلك خانة A/B النشطة أو غير النشطة (أوضاع الروت).</string>
    <string name="onboarding_feature_apps_title">التطبيقات</string>
    <string name="onboarding_feature_apps_desc">ملفات APK وملفات APK المقسّمة والبيانات الداخلية والبيانات الخارجية وملفات التوسعة OBB والذواكر المؤقتة، محددة لكل تطبيق على حدة.</string>
    <string name="onboarding_feature_files_title">الملفات والفئات</string>
    <string name="onboarding_feature_files_desc">أي مجلد، إضافةً إلى فئات ذكية مثل الصور ومقاطع الفيديو والمستندات وقواعد البيانات، مُضيَّقة بمرشّحات الحجم والتاريخ والنمط.</string>
    <string name="onboarding_feature_destinations_title">الوجهات</string>
    <string name="onboarding_feature_destinations_desc">التخزين المحلي، ومحركات USB OTG، وخوادم FTP/FTPS وSFTP/SSH وSMB وWebDAV وNFS، وأي مزوّد سحابي يمكن الوصول إليه عبر rclone.</string>
    <string name="onboarding_feature_pipelines_title">مسارات مرنة</string>
    <string name="onboarding_feature_pipelines_desc">حاويات tar أو zip مع ضغط zstd أو xz أو gzip أو bzip2، وتشفير AES-256 مع إخفاء أسماء الملفات، وبيانات تحقق بالمجاميع، وبثّ مباشر إلى الوجهة.</string>
    <string name="onboarding_feature_twrp_title">نسخ احتياطية متوافقة مع الاسترداد</string>
    <string name="onboarding_feature_twrp_desc">تخطيطات اختيارية متوافقة مع TWRP وOrangeFox بحيث يمكن أيضًا استعادة النسخة الاحتياطية من الاسترداد المخصّص.</string>
    <string name="onboarding_feature_restore_title">استعادة متماثلة بالكامل</string>
    <string name="onboarding_feature_restore_desc">كل ما ينسخه DFTB احتياطيًا يمكنه استعادته: ملفات تعريف كاملة، أو تطبيقات مفردة، أو ملفات مختارة، أو صورة قسم واحد، مع التحقق من السلامة أولًا.</string>
    <string name="onboarding_feature_scheduling_title">الجدولة والاحتفاظ والاستئناف</string>
    <string name="onboarding_feature_scheduling_desc">جداول يومية أو أسبوعية أو بفواصل زمنية مع شروط Wi‑Fi والشحن والبطارية؛ تقليم تلقائي للنسخ الاحتياطية القديمة؛ تستأنف المهام المتوقفة من آخر نقطة تفتيش لها.</string>

    <!-- ===================== Step 3: responsibility ===================== -->
    <string name="onboarding_disclaimer_title">مسؤوليتك</string>
    <string name="onboarding_disclaimer_description">يمنحك DFTB تحكّمًا قويًا ومنخفض المستوى في جهازك الخاص. يُرجى قراءة هذه النقاط قبل المتابعة.</string>
    <string name="onboarding_disclaimer_partitions">قد تؤدي كتابة الأقسام إلى جعل الجهاز غير قابل للإقلاع. لا تستعد سوى صور الأقسام التي أنشأتها على هذا الجهاز والبرنامج الثابت نفسيهما بالضبط.</string>
    <string name="onboarding_disclaimer_verify">تحقّق دائمًا من النسخ الاحتياطية واحتفظ بنسخة ثانية على وسيط مختلف. النسخة الاحتياطية التي لم تختبرها قط ليست نسخة احتياطية.</string>
    <string name="onboarding_disclaimer_passwords">لا يمكن استرداد كلمات مرور التشفير ومفاتيحه. إذا فقدتها، فُقدت النسخة الاحتياطية المشفّرة أيضًا.</string>
    <string name="onboarding_disclaimer_elevation">منح وصول الروت أو Shizuku، وكل ما يُفعل به، قرارك ومسؤوليتك. لا يستخدمه DFTB إلا للعمليات التي تبدؤها أو تجدولها.</string>
    <string name="onboarding_disclaimer_cloud">يخضع التخزين السحابي والشبكي لشروط المزوّد وتوفّره وتسعيره. لا يتحكم DFTB في خدمات الأطراف الثالثة.</string>
    <string name="onboarding_disclaimer_warranty">‏DFTB برنامج حر مفتوح المصدر يُقدَّم دون أي ضمان، بموجب شروط رخصته مفتوحة المصدر.</string>
    <string name="onboarding_disclaimer_accept">أفهم ذلك وأوافق عليه</string>

    <!-- ===================== Step 4: licenses ===================== -->
    <string name="onboarding_licenses_title">رخص مفتوحة المصدر وشكر وتقدير</string>
    <string name="onboarding_licenses_description">يقوم DFTB على أكتاف هذه المشاريع. انقر على أي مُدخَل لعرض التفاصيل؛ يفتح زرّا المصدر والرخصة المشروع في متصفحك.</string>
