    <string name="restore_ui_critical_selected_body">يحتوي %1$s على بيانات فريدة لجهاز واحد (IMEI والمعايرة وDRM وحماية إعادة ضبط المصنع). قد تؤدي كتابة النسخة الخاطئة إلى تعطيل هذا الجهاز نهائيًا. تُرفض ما لم تسمح بذلك أدناه.</string>
    <string name="restore_ui_slot_title">الخانة المراد الكتابة عليها</string>
    <string name="restore_ui_slot_same_role">الدور نفسه</string>
    <string name="restore_ui_slot_active">الخانة النشطة</string>
    <string name="restore_ui_slot_inactive">الخانة غير النشطة</string>
    <string name="restore_ui_slot_recorded">الحرف نفسه</string>
    <string name="restore_ui_slot_same_role_desc">يكتب على الخانة التي تؤدي الآن الدور (نشطة أو غير نشطة) الذي كانت تؤديه الخانة المنسوخة. موصى به: تتبدل الخانتان بعد كل تحديث.</string>
    <string name="restore_ui_slot_active_desc">يكتب على الخانة التي أقلع منها الجهاز الآن.</string>
    <string name="restore_ui_slot_inactive_desc">يكتب على الخانة التي لم يُقلع منها الجهاز.</string>
    <string name="restore_ui_slot_recorded_desc">يكتب على حرف الخانة نفسه الذي نُسخ (boot_a إلى boot_a).</string>
    <string name="restore_ui_overrides_title">فحوصات الأمان</string>
    <string name="restore_ui_overrides_hint">ترفض هذه الفحوصات عمليات الكتابة الخطرة. يمكن إيقاف كل منها فقط بعد أن تؤكد ما قد يحدث من مشكلات.</string>

    <!-- Risky options -->
    <string name="restore_ui_risky_enable">أفهم ذلك، اسمح به</string>
    <string name="restore_ui_risky_active_title">فحوصات الأمان التي أوقفتها</string>
    <string name="restore_ui_risky_space">الاستعادة دون مساحة حرة كافية</string>
    <string name="restore_ui_risky_space_hint">المتابعة حتى لو أبلغت وجهة عن مساحة حرة قليلة جدًا.</string>
    <string name="restore_ui_risky_space_consequence">قد تمتلئ الوجهة أثناء الاستعادة. تبقى الملفات المكتوبة حتى الآن؛ وتفشل البقية، وقد تتوقف التطبيقات على هذا الجهاز عن العمل إلى أن تُحرَّر مساحة.</string>
    <string name="restore_ui_risky_downgrade">السماح بإصدارات تطبيقات أقدم</string>
    <string name="restore_ui_risky_downgrade_hint">تثبيت نسخة محفوظة احتياطيًا أقدم من المثبتة (Shizuku أو الجذر).</string>
    <string name="restore_ui_risky_downgrade_consequence">قد لا يفهم إصدار أقدم من التطبيق البيانات التي كتبها الإصدار الأحدث. قد ينهار التطبيق أو يفقد بياناته. وقد يرفض Android الرجوع إلى إصدار أقدم لبعض التطبيقات.</string>
    <string name="restore_ui_risky_cross_slot">السماح بالكتابة على الخانة الأخرى</string>
    <string name="restore_ui_risky_cross_slot_hint">الخانة المختارة تختلف عن الخانة التي نُسخت.</string>
    <string name="restore_ui_risky_cross_slot_consequence">ستُستبدل أقسام الخانة الأخرى. إذا لم تطابق الصور باقي تلك الخانة، فقد يفشل الجهاز في الإقلاع منها؛ وقد ينتقل إليها أيضًا عند التحديث التالي.</string>
    <string name="restore_ui_risky_other_device">السماح بصور من جهاز آخر</string>
    <string name="restore_ui_risky_other_device_hint">أُخذت الصور على طراز جهاز مختلف، أو يتعذر إثبات مصدرها.</string>
    <string name="restore_ui_risky_other_device_consequence">صور الأقسام خاصة بطراز جهاز واحد. كتابة صورة جهاز آخر قد تعطل هذا الجهاز تعطيلًا تامًا بحيث لا تستعيده إلا أداة الفلاش الخاصة بالمصنع.</string>
    <string name="restore_ui_risky_other_build">السماح بصور من بناء آخر</string>
    <string name="restore_ui_risky_other_build_hint">الجهاز نفسه، لكن ببناء نظام مختلف (مثلًا قبل تحديث).</string>
    <string name="restore_ui_risky_other_build_consequence">قد يسبب خلط أقسام من بناءات مختلفة حلقات إقلاع أو تعطل ميزات (الكاميرا والراديو والتشفير). استعد كل أقسام ذلك البناء معًا.</string>
    <string name="restore_ui_risky_smaller_image">السماح بصور أصغر من القسم</string>
    <string name="restore_ui_risky_smaller_image_hint">يُترك طرف القسم كما هو.</string>
    <string name="restore_ui_risky_smaller_image_consequence">يحتفظ القسم ببيانات قديمة بعد الصورة. وهذا غير ضار لبعض الأقسام لكنه يعطل أخرى (مثل التي لها تذييل أو توقيع في النهاية).</string>
    <string name="restore_ui_risky_identity">السماح بالكتابة على أقسام الهوية</string>
    <string name="restore_ui_risky_identity_hint">IMEI/NV ومعايرة المودم وpersist وحماية إعادة ضبط المصنع وما شابهها.</string>
    <string name="restore_ui_risky_identity_consequence">هذه الأقسام فريدة لجهاز مادي واحد. نسخة من جهاز آخر، أو نسخة قديمة، أو تالفة قد تعطل المكالمات أو بيانات الجوال أو Wi-Fi أو DRM أو محمّل الإقلاع نهائيًا. لا يمكن التراجع.</string>
