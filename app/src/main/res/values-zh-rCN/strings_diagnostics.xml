    <string name="diag_probe_hint">诊断运行本身意外失败。请重新运行；如果持续出现，请从系统概览分享日志。</string>
    <string name="diag_check_timed_out_hint">检查未能及时完成。通常由待处理的超级用户授权提示或无响应的服务导致；请回应任何提示并重新运行。</string>
    <string name="diag_check_failed_hint">检查在产生结果前崩溃。原始错误显示在上方。</string>

    <!-- Standard (all modes) -->
    <string name="diag_sdk_level_title">Android 版本</string>
    <string name="diag_all_files_access_title">所有文件访问</string>
    <string name="diag_all_files_access_hint">DFTB 必须读写整个共享存储才能备份文件和写入归档。请在系统设置页面授予"所有文件访问"权限。</string>
    <string name="diag_all_files_access_optional_hint">未授予。root Shell 仍可读取所有内容，但将无法在不使用 SAF 的情况下浏览共享存储。</string>
    <string name="diag_legacy_storage_title">存储权限</string>
    <string name="diag_legacy_storage_hint">在 Android 10 上，读写共享存储需要存储运行时权限。</string>
    <string name="diag_legacy_storage_optional_hint">未授予。root Shell 仍可读取所有内容，但将无法直接浏览共享存储。</string>
    <string name="diag_notifications_title">通知</string>
    <string name="diag_notifications_hint">没有通知，正在运行的备份在应用处于后台时将无法显示进度或报告失败。</string>
    <string name="diag_saf_title">文档选择器（SAF）</string>
    <string name="diag_saf_hint">没有应用处理文件夹选择器。此设备上无法选择 SD 卡和 USB 驱动器上的目标位置。</string>
    <string name="diag_battery_title">电池优化</string>
    <string name="diag_battery_hint">在慢速连接上进行的长时间备份可能被 Doze 终止。排除 DFTB 可保持定时任务和续传任务继续运行。</string>
    <string name="diag_free_space_title">可用空间（应用存储）</string>
    <string name="diag_free_space_hint">可用空间不足 500 MB。临时归档和任务日志保存在此处；备份前请先释放一些空间。</string>

