    <string name="backup_engine_error_verify">已存储的文件与写入的内容不符，可能已损坏。</string>
    <string name="backup_engine_error_manifest">无法写入备份索引。</string>
    <string name="backup_engine_error_all_failed">备份的任何部分都未能完成。</string>
    <string name="backup_engine_error_internal">备份因意外错误而停止。</string>

