<?xml version="1.0" encoding="utf-8"?>
<!-- Backup engine (core/pipeline/engine): progress messages, results, failures and warnings that
     appear in notifications, History and the live terminal. Technical detail stays in English
     and is appended in parentheses. -->
<resources>

    <!-- Progress -->
    <string name="backup_engine_planning">正在准备备份…</string>
    <string name="backup_engine_preflight">正在检查可用空间…</string>
    <string name="backup_engine_uploading">正在上传 %1$s…</string>
    <string name="backup_engine_verifying">正在验证 %1$s…</string>
    <string name="backup_engine_writing_manifest">正在写入备份索引…</string>

    <!-- Results -->
    <plurals name="backup_engine_completed">
        <item quantity="other">已备份 %1$d 个项目。</item>
    </plurals>
    <plurals name="backup_engine_warning_count">
        <item quantity="other">%1$d 条警告。</item>
    </plurals>
    <string name="backup_engine_cancelled">备份已取消。已删除部分文件。</string>

    <!-- Failures (BackupErrorCode) -->
    <string name="backup_engine_error_no_destination">此配置文件没有目标位置。请选择备份的保存位置。</string>
    <string name="backup_engine_error_destination_not_found">该配置文件的目标位置已不存在。</string>
    <string name="backup_engine_error_nothing">未选择任何要备份的内容。</string>
