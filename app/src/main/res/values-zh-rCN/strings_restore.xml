    <string name="restore_engine_error_unsupported">此备份的创建方式是当前版本的 DFTB 无法恢复的。</string>
    <string name="restore_engine_error_nothing">未选择任何要恢复的内容。</string>
    <string name="restore_engine_error_blocked">在当前模式下，所选项目均无法恢复。</string>
    <string name="restore_engine_error_space">可用空间不足，无法恢复。</string>
    <string name="restore_engine_error_verify">备份已损坏；未恢复任何内容。</string>
    <string name="restore_engine_error_all_failed">所有选定项目均恢复失败。</string>
    <string name="restore_engine_error_internal">恢复因意外错误而停止。</string>

    <!-- Unit-level notices -->
    <string name="restore_engine_no_app_restorer">此版本不支持恢复应用。</string>
    <string name="restore_engine_no_partition_restorer">此版本不支持恢复分区。</string>
    <string name="restore_engine_unit_blocked">无法恢复 %1$s：%2$s</string>
    <string name="restore_engine_space_unknown">%1$s 的可用空间未知；恢复期间空间可能耗尽。</string>
