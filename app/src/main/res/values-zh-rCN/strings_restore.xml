    <string name="restore_engine_cross_device">此备份来自 %1$s；此设备是 %2$s。</string>
    <string name="restore_engine_resume_skipped">%1$s 已恢复，已跳过。</string>
    <string name="restore_engine_partial_backup">此备份未完成；只能恢复其中包含的项目。</string>
    <string name="restore_engine_checkpoint_failed">无法保存恢复进度；中断的恢复将从头开始。</string>
    <plurals name="restore_engine_more_issues">
        <item quantity="other">…另有 %1$d 个问题。</item>
    </plurals>
    <plurals name="restore_engine_unmapped">
        <item quantity="other">%1$d 个文件没有已知的原始位置，未被恢复。请改为将其恢复到某个文件夹。</item>
    </plurals>
    <plurals name="restore_engine_kept_existing">
        <item quantity="other">已保留 %1$d 个现有文件。</item>
    </plurals>

