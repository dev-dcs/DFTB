<?xml version="1.0" encoding="utf-8"?>
<!-- Restore engine (core/restore): progress, results, failures and per-file problems shown in
     notifications, History and the restore screens. Technical detail stays in English and is
     appended in parentheses. -->
<resources>

    <!-- Progress -->
    <string name="restore_engine_opening">正在读取备份…</string>
    <string name="restore_engine_preflight">正在检查可恢复的内容…</string>
    <string name="restore_engine_verifying">恢复前正在验证备份…</string>
    <string name="restore_engine_restoring">正在恢复 %1$s…</string>

    <!-- Results -->
    <plurals name="restore_engine_completed">
        <item quantity="other">已恢复 %1$d 个项目。</item>
    </plurals>
    <plurals name="restore_engine_warning_count">
        <item quantity="other">%1$d 条警告。</item>
    </plurals>
    <string name="restore_engine_cancelled">恢复已停止。已恢复的文件会保留。</string>

    <!-- Failures (RestoreErrorCode) -->
    <string name="restore_engine_error_destination">此备份的目标位置已不存在。</string>
    <string name="restore_engine_error_open">无法读取该备份。</string>
