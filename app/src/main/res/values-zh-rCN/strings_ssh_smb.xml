<?xml version="1.0" encoding="utf-8"?>
<!-- SFTP/SSH, SMB and NFS storage backends (core/storage/{ssh,smb,nfs}). These become
     StorageException messages shown when a destination connection test or transfer fails.
     Technical detail (server error text, fingerprints, paths) is passed in as format arguments. -->
<resources>

    <!-- Shared -->
    <string name="storage_net_missing_host">目标位置未配置主机名。</string>
    <string name="storage_net_missing_credential">目标位置没有保存的凭据。</string>
    <string name="storage_net_credential_not_found">找不到此目标位置保存的凭据。</string>
    <string name="storage_net_credential_wrong_kind">此协议不支持已保存的凭据类型。</string>
    <string name="storage_net_missing_username">目标位置未配置用户名。</string>
    <string name="storage_net_connect_failed">无法连接到 %1$s：%2$s</string>
    <string name="storage_net_op_failed">远程操作失败（%1$s）：%2$s</string>
    <string name="storage_net_not_a_directory">“%1$s”不是目标位置上的文件夹。</string>
    <string name="storage_net_transfer_timeout">传输未能及时开始（%1$s）。</string>

    <!-- SFTP / SSH -->
    <string name="storage_ssh_auth_failed">SSH 服务器拒绝了用户名、密码或密钥。</string>
    <string name="storage_ssh_key_unreadable">无法读取已保存的私钥。请检查密钥格式和口令。</string>
    <string name="storage_ssh_host_key_changed">%1$s 的 SSH 主机密钥已更改（现为 %2$s）。为保护你的数据，连接已被拒绝。如果服务器是有意重装的，请忘记其已保存的密钥后重新连接。</string>
    <string name="storage_ssh_no_shell">SSH 服务器不提供 SFTP，且拒绝了 shell 命令回退方式。</string>

    <!-- SMB -->
    <string name="storage_smb_missing_share">未配置共享。请将共享名称作为路径的第一级文件夹，或设置共享选项。</string>
    <string name="storage_smb_not_disk_share">“%1$s”不是文件共享。</string>
    <string name="storage_smb_encryption_unsupported">已请求加密，但服务器不支持 SMB 3 加密。</string>
    <string name="storage_smb_auth_failed">SMB 服务器拒绝了用户名或密码。</string>

    <!-- NFS -->
    <string name="storage_nfs_requires_root">NFS 需要 Root 模式：Android 不允许普通应用挂载网络共享。请在设置中切换到 Root 模式以使用此目标位置。</string>
    <string name="storage_nfs_root_unavailable">当前未授予 Root 权限，因此无法挂载 NFS 共享。</string>
    <string name="storage_nfs_kernel_unsupported">此设备的内核不支持 NFS 客户端，因此无法挂载 NFS 共享。</string>
    <string name="storage_nfs_missing_export">未配置 NFS 导出路径（例如 /srv/backups）。</string>
    <string name="storage_nfs_bad_options">NFS 挂载选项包含不支持的字符。</string>
    <string name="storage_nfs_mount_failed">挂载 %1$s 失败：%2$s</string>
</resources>
