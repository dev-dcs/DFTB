    <!-- ===================== Step 2: overview ===================== -->
    <string name="onboarding_overview_title">DFTB 能做什么</string>
    <string name="onboarding_overview_description">一套面向你所拥有设备的开源备份与灾难恢复工具包。以下所有功能均为可选；由你决定保护什么以及备份到哪里。</string>
    <string name="onboarding_feature_partitions_title">分区镜像</string>
    <string name="onboarding_feature_partitions_desc">对 boot、vendor_boot、dtbo、persist 及其他分区进行块级镜像，包括活动或非活动的 A/B 槽位（root 模式）。</string>
    <string name="onboarding_feature_apps_title">应用</string>
    <string name="onboarding_feature_apps_desc">APK 与分包 APK、内部数据、外部数据、OBB 扩展文件和缓存，可按应用逐一选择。</string>
    <string name="onboarding_feature_files_title">文件与类别</string>
    <string name="onboarding_feature_files_desc">任意文件夹，以及照片、视频、文档、数据库等智能类别，可按大小、日期和模式进行筛选。</string>
    <string name="onboarding_feature_destinations_title">目标位置</string>
    <string name="onboarding_feature_destinations_desc">本地存储、USB OTG 驱动器、FTP/FTPS、SFTP/SSH、SMB、WebDAV 和 NFS 服务器，以及任何可通过 rclone 访问的云服务提供商。</string>
    <string name="onboarding_feature_pipelines_title">灵活的处理流程</string>
    <string name="onboarding_feature_pipelines_desc">tar 或 zip 容器，支持 zstd、xz、gzip 或 bzip2 压缩，支持带文件名遮蔽的 AES-256 加密、校验和清单，以及直接流式传输到目标位置。</string>
    <string name="onboarding_feature_twrp_title">兼容 Recovery 的备份</string>
    <string name="onboarding_feature_twrp_desc">可选的 TWRP 和 OrangeFox 兼容布局，使备份也能从第三方 Recovery 中还原。</string>
    <string name="onboarding_feature_restore_title">完全对称还原</string>
    <string name="onboarding_feature_restore_desc">DFTB 备份的一切都能还原：整个配置、单个应用、选定文件或某个分区镜像，并会先进行完整性校验。</string>
    <string name="onboarding_feature_scheduling_title">定时、保留与续传</string>
    <string name="onboarding_feature_scheduling_desc">每日、每周或按间隔的定时任务，可设置 Wi‑Fi、充电和电量条件；自动清理旧备份；中断的任务可从上次检查点续传。</string>

    <!-- ===================== Step 3: responsibility ===================== -->
    <string name="onboarding_disclaimer_title">你的责任</string>
    <string name="onboarding_disclaimer_description">DFTB 让你对自己的设备拥有强大的底层控制能力。请在继续前阅读以下要点。</string>
    <string name="onboarding_disclaimer_partitions">写入分区可能导致设备无法启动。只还原你在此设备和固件上创建的分区镜像。</string>
    <string name="onboarding_disclaimer_verify">务必校验备份并在不同介质上保留第二份副本。从未测试过的备份不算备份。</string>
    <string name="onboarding_disclaimer_passwords">加密密码和密钥无法找回。一旦丢失，加密备份也将随之丢失。</string>
    <string name="onboarding_disclaimer_elevation">授予 root 或 Shizuku 访问权限，以及由此进行的一切操作，均由你决定并由你负责。DFTB 仅将其用于你启动或定时的操作。</string>
    <string name="onboarding_disclaimer_cloud">云端和网络存储受服务提供商的条款、可用性和价格约束。DFTB 无法控制第三方服务。</string>
    <string name="onboarding_disclaimer_warranty">DFTB 是免费的开源软件，依据其开源许可证的条款提供，不附带任何担保。</string>
    <string name="onboarding_disclaimer_accept">我已理解并接受</string>

    <!-- ===================== Step 4: licenses ===================== -->
    <string name="onboarding_licenses_title">开源许可证与致谢</string>
    <string name="onboarding_licenses_description">DFTB 站在这些项目的肩膀上。点按条目查看详情；"源代码"和"许可证"按钮会在浏览器中打开对应项目。</string>
