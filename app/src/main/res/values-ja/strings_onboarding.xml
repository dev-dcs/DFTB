    <!-- ===================== Step 1: language ===================== -->
    <string name="onboarding_language_title">言語を選択</string>
    <string name="onboarding_language_description">アプリ全体が即座に切り替わります。この設定は後でシステム概要または設定から変更できます。</string>
    <string name="onboarding_language_suggested">デバイスの設定からの候補：%1$s</string>
    <string name="onboarding_language_use_suggested">%1$s を使用</string>

    <!-- ===================== Step 2: overview ===================== -->
    <string name="onboarding_overview_title">DFTB でできること</string>
    <string name="onboarding_overview_description">あなたが所有するデバイスのための、オープンソースのバックアップおよび災害復旧ツールキットです。以下はすべて任意です。何を保護し、どこに保存するかはあなたが決めます。</string>
    <string name="onboarding_feature_partitions_title">パーティションイメージ</string>
    <string name="onboarding_feature_partitions_desc">boot、vendor_boot、dtbo、persist などのパーティションのブロックレベルイメージ。アクティブ／非アクティブな A/B スロットを含みます（root モード）。</string>
    <string name="onboarding_feature_apps_title">アプリ</string>
    <string name="onboarding_feature_apps_desc">APK および分割 APK、内部データ、外部データ、OBB 拡張ファイル、キャッシュを、アプリごとに選択してバックアップします。</string>
    <string name="onboarding_feature_files_title">ファイルとカテゴリ</string>
    <string name="onboarding_feature_files_desc">任意のフォルダーに加え、写真・動画・ドキュメント・データベースなどのスマートカテゴリを、サイズ・日付・パターンフィルターで絞り込めます。</string>
    <string name="onboarding_feature_destinations_title">保存先</string>
    <string name="onboarding_feature_destinations_desc">ローカルストレージ、USB OTG ドライブ、FTP/FTPS、SFTP/SSH、SMB、WebDAV、NFS サーバー、および rclone 経由で到達できるあらゆるクラウドプロバイダー。</string>
    <string name="onboarding_feature_pipelines_title">柔軟なパイプライン</string>
    <string name="onboarding_feature_pipelines_desc">zstd、xz、gzip、bzip2 圧縮を使用した tar または zip コンテナ、ファイル名マスキング付きの AES-256 暗号化、チェックサムマニフェスト、保存先への直接ストリーミング。</string>
    <string name="onboarding_feature_twrp_title">リカバリ互換バックアップ</string>
    <string name="onboarding_feature_twrp_desc">任意の TWRP および OrangeFox 互換レイアウトにより、カスタムリカバリからもバックアップを復元できます。</string>
    <string name="onboarding_feature_restore_title">完全対称の復元</string>
    <string name="onboarding_feature_restore_desc">DFTB がバックアップするものはすべて復元できます。プロファイル全体、単一アプリ、選択したファイル、1 つのパーティションイメージを、まず整合性を検証したうえで復元します。</string>
    <string name="onboarding_feature_scheduling_title">スケジュール、保持、再開</string>
    <string name="onboarding_feature_scheduling_desc">Wi‑Fi、充電、バッテリー条件付きの毎日・毎週・間隔スケジュール。古いバックアップの自動削除。中断されたジョブは最後のチェックポイントから再開します。</string>

    <!-- ===================== Step 3: responsibility ===================== -->
    <string name="onboarding_disclaimer_title">あなたの責任</string>
    <string name="onboarding_disclaimer_description">DFTB は、あなた自身のデバイスに対する強力で低レベルの制御を提供します。続行する前に、これらの点をお読みください。</string>
    <string name="onboarding_disclaimer_partitions">パーティションへの書き込みは、デバイスを起動不能にする可能性があります。パーティションイメージは、まさにこのデバイスとファームウェアで作成したものだけを復元してください。</string>
    <string name="onboarding_disclaimer_verify">常にバックアップを検証し、別のメディアに 2 つ目のコピーを保管してください。一度もテストしていないバックアップは、バックアップではありません。</string>
    <string name="onboarding_disclaimer_passwords">暗号化のパスワードと鍵は復元できません。紛失すると、暗号化されたバックアップも失われます。</string>
    <string name="onboarding_disclaimer_elevation">root または Shizuku アクセスの許可、およびそれを用いて行うことはすべて、あなたの判断と責任です。DFTB は、あなたが開始またはスケジュールした操作にのみそれを使用します。</string>
    <string name="onboarding_disclaimer_cloud">クラウドおよびネットワークストレージは、プロバイダーの規約、可用性、料金の対象となります。DFTB はサードパーティのサービスを制御しません。</string>
    <string name="onboarding_disclaimer_warranty">DFTB は無料のオープンソースソフトウェアであり、そのオープンソースライセンスの条件の下、いかなる保証もなく提供されます。</string>
    <string name="onboarding_disclaimer_accept">理解し、同意します</string>

    <!-- ===================== Step 4: licenses ===================== -->
    <string name="onboarding_licenses_title">オープンソースライセンスとクレジット</string>
    <string name="onboarding_licenses_description">DFTB はこれらのプロジェクトの上に成り立っています。項目をタップすると詳細が表示されます。「ソース」と「ライセンス」ボタンはプロジェクトをブラウザーで開きます。</string>
